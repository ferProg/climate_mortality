   "source": [
    "# Fase 6 — Provincial Regression Modeling\n",
    "## SC Tenerife + Las Palmas | Models P1 & P2\n",
    "\n",
    "Regression analysis at **provincial scale** following the same specification as CCAA/model_p1_p2.ipynb.\n",
    "\n",
    "| Province | Islands included | Dominant temp proxy |\n",
    "|---|---|---|\n",
    "| SC Tenerife | TFE + La Palma + Gomera | Tenerife island |\n",
    "| Las Palmas | GC + Lanzarote + Fuerteventura | Gran Canaria island |\n",
    "\n",
    "**Period:** 2009–2025 (887 weeks per province, after 1-week lag)\n",
    "\n",
    "**Models:**\n",
    "- **P1** — OLS: `deaths ~ calima_score + lag_deaths + C(month) + calima×lag + temp_c_mean`\n",
    "- **P2** — First-difference OLS (HC3 robust): `deaths_diff ~ calima_score + C(month) + temp_c_mean`\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "a7afedeb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SC Tenerife: 886 weeks | deaths mean=149.4 ± 26.3\n",
      "Las Palmas:  886 weeks  | deaths mean=147.8 ± 27.9\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import statsmodels.formula.api as smf\n",
    "from statsmodels.stats.stattools import durbin_watson\n",
    "from statsmodels.stats.diagnostic import het_breuschpagan\n",
    "import matplotlib.pyplot as plt\n",
    "import scipy.stats as stats\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from pathlib import Path\n",
    "BASE = Path().resolve().parent  # notebook in provinces/, project root one level up\n",
    "\n",
    "# ── LOAD DATA ─────────────────────────────────────────────────────────────────\n",
    "df_tfe_prov = pd.read_parquet(f\"{BASE}/data/processed/provinces/master_provincial_sc_tenerife_2009_2025.parquet\")\n",
    "df_lp_prov  = pd.read_parquet(f\"{BASE}/data/processed/provinces/master_provincial_las_palmas_2009_2025.parquet\")\n",
    "df_reg      = pd.read_csv(f\"{BASE}/data/processed/provinces/regression_ready_tfe_gc.csv\")\n",
    "df_reg['week_start'] = pd.to_datetime(df_reg['week_start'], dayfirst=True)\n",
    "\n",
    "# Temperature: use dominant island per province\n",
    "tfe_temp = df_reg[df_reg['island']=='tenerife'][['week_start','temp_c_mean']].copy()\n",
    "gc_temp  = df_reg[df_reg['island']=='gran_canaria'][['week_start','temp_c_mean']].copy()\n",
    "\n",
    "def build_df(prov_df):\n",
    "    df = prov_df.sort_values('week_start').reset_index(drop=True)\n",
    "    df['lag_deaths']  = df['deaths'].shift(1)\n",
    "    df['deaths_diff'] = df['deaths'] - df['lag_deaths']\n",
    "    df['month']       = df['week_start'].dt.month\n",
    "    return df.dropna(subset=['lag_deaths']).reset_index(drop=True)\n",
    "\n",
    "df_tfe = build_df(df_tfe_prov)\n",
    "df_lp  = build_df(df_lp_prov)\n",
    "\n",
    "print(f\"SC Tenerife: {df_tfe.shape[0]} weeks | deaths mean={df_tfe.deaths.mean():.1f} ± {df_tfe.deaths.std():.1f}\")\n",
    "print(f\"Las Palmas:  {df_lp.shape[0]} weeks  | deaths mean={df_lp.deaths.mean():.1f} ± {df_lp.deaths.std():.1f}\")\n"
   ]
  },
