   "source": [
    "formula_p1 = (\n",
    "    \"deaths ~ calima_score_provincial \"\n",
    "    \"+ lag_deaths \"\n",
    "    \"+ C(month) \"\n",
    "    \"+ calima_score_provincial:lag_deaths \"\n",
    "    \"+ temp_c_mean\"\n",
    ")\n",
    "\n",
    "# SC Tenerife\n",
    "m_p1_tfe = smf.ols(formula=formula_p1, data=df_tfe).fit(cov_type='HC3')\n",
    "print(\"=== MODEL P1 — SC Tenerife ===\")\n",
    "print(m_p1_tfe.summary())\n",
    "dw1_tfe = durbin_watson(m_p1_tfe.resid)\n",
    "print(f\"Durbin-Watson: {dw1_tfe:.3f}\")\n"
   ]
